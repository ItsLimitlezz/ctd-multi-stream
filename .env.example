# CTD Multi-Stream settings for docker compose: copy to `.env` next to docker-compose.yml.
# Everything is optional. Leave a line commented out to keep the default, and never set a variable to an
# empty value (an empty value is not the same as "unset"). Restart after changes: docker compose up -d
# TrueNAS: put the variables you need under `environment:` in the app's YAML instead.

# --- Image --------------------------------------------------------------------------------------------
# Prebuilt image. <owner> = the GitHub user/organization that publishes CTD Multi-Stream (lowercase).
# Tags: latest = newest release, X.Y.Z = a specific release, main = development builds.
# Unset = build the image from this checkout.
#CTD_IMAGE=ghcr.io/<owner>/ctd-multi-stream:latest

# --- HTTPS --------------------------------------------------------------------------------------------
# auto        (default) Let's Encrypt certificate for your public IP (or PUBLIC_HOST); self-signed until
#             it is issued, or for good when there is no reachable public IP (e.g. CGNAT).
# letsencrypt same as auto, for setups that require a trusted certificate (failures are logged as errors).
# self-signed never contacts Let's Encrypt.
# manual      your own certificate: TLS_CERT_FILE + TLS_KEY_FILE (paths inside the container, e.g. /data/...).
# off         plain HTTP, ONLY behind your own HTTPS reverse proxy (then also set TRUST_PROXY=true).
TLS_MODE=auto

# Public HTTPS port your router forwards (used to build links and redirects). Default 443.
#PUBLIC_PORT=443

# Use a domain name instead of the IP address (its DNS must point at your public IP). Let's Encrypt then
# issues a normal 90-day certificate for the domain.
#PUBLIC_HOST=stream.example.com

# Public IP override. Normally discovered automatically.
#PUBLIC_IP=203.0.113.7

# Contact e-mail for the Let's Encrypt account (expiry/problem notices).
#ACME_EMAIL=you@example.com

# Use Let's Encrypt's staging environment (untrusted test certificates) while experimenting.
#ACME_STAGING=false

# TLS_MODE=manual only.
#TLS_CERT_FILE=/data/tls/my.crt
#TLS_KEY_FILE=/data/tls/my.key

# Trust X-Forwarded-* headers. Only behind your own reverse proxy; never when port-forwarding directly.
#TRUST_PROXY=false

# --- Secrets ------------------------------------------------------------------------------------------
# Master key that encrypts stream keys, OAuth tokens and browser sessions: 64 hex chars
# (generate with `openssl rand -hex 32`). Unset = generated once into /data/master.key.
# Losing it makes every stored key/token unreadable. Changing it later does the same.
#MASTER_KEY=

# --- Logs ---------------------------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
#LOG_LEVEL=info

# --- Kick chat ----------------------------------------------------------------------------------------
# Kick chat is read from Kick's public Pusher websocket with a built-in app key and cluster. That key is not
# an official API and has changed before. If Kick chat fails with "Kick may have changed its chat key", set
# the new values here (from kick.com's web frontend) without waiting for a new release.
#KICK_PUSHER_KEY=
#KICK_PUSHER_CLUSTER=us2

# --- Advanced (leave alone in Docker) -----------------------------------------------------------------
# Ports INSIDE the container. To use other ports on the host, change the left side of `ports:` in
# docker-compose.yml instead. Exception: RTMP. Settings > OBS setup shows RTMP_PORT, so if 1935 is taken on
# the host, set RTMP_PORT to the new number AND map it 1:1 (e.g. RTMP_PORT=1936 with "1936:1936").
#WEB_PORT=8443
#HTTP_PORT=8080
#RTMP_PORT=1935
#MEDIAMTX_API_PORT=9997

# Run the automation browser with a visible window (needs a display; development only).
#BROWSER_HEADLESS=true

# Set by the image; only needed when running from source (npm run dev).
#DATA_DIR=./data
#MEDIAMTX_BIN=./tools/mediamtx
#FFMPEG_BIN=./tools/ffmpeg
#WEB_DIR=./dist/web
